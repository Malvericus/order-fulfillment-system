{
  "title": "Fulfillment Overview",
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate (per service)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)"}]
    },
    {
      "type": "timeseries",
      "title": "p99 latency (per service)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, application))"}]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx, per service)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (application)"}]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag (max, per topic)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "max(kafka_consumer_fetch_manager_records_lag_max) by (topic)"}]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
